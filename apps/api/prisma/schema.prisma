generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum LoginResult {
  SUCCESS
  FAILURE
}

enum MerchantStatus {
  ACTIVE
  DISABLED
}

enum StoreStatus {
  ACTIVE
  DISABLED
}

enum ProductListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SkuStatus {
  ACTIVE
  DISABLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDING
  REFUNDED
}

enum ProductOptimizationStatus {
  GENERATING
  DRAFT
  APPLIED
  REJECTED
  ERROR
}

enum BatchTaskStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL_FAILED
  CANCELLED
}

enum BatchTaskItemStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum RuleDocumentScope {
  GLOBAL
  MERCHANT
}

enum RuleDocumentStatus {
  ACTIVE
  ARCHIVED
}

enum AgentRunStatus {
  PLANNING
  RUNNING
  COMPLETED
  FAILED
}

enum ImportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL_FAILED
  CANCELLED
}

enum ImportItemStatus {
  VALIDATION_FAILED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportMode {
  DRAFT_ONLY
  DRAFT_AND_AI
}

model User {
  id                     String                    @id @default(cuid()) @db.VarChar(30)
  email                  String                    @unique @db.VarChar(191)
  name                   String                    @db.VarChar(100)
  passwordHash           String                    @map("password_hash") @db.VarChar(255)
  status                 UserStatus                @default(ACTIVE)
  userRoles              UserRole[]
  refreshTokens          RefreshToken[]
  loginLogs              LoginLog[]
  merchantUsers          MerchantUser[]
  aiSessions             AiSession[]
  optimizations          ProductOptimization[]
  productVersions        ProductVersion[]
  auditLogs              AuditLog[]
  batchTasks             BatchOptimizationTask[]
  ruleDocuments          RuleDocument[]
  agentRuns              AgentRun[]
  createdSessionShares   AiSessionShare[]          @relation("SessionShareCreator")
  sessionShareRecipients AiSessionShareRecipient[]
  aiMessageLinks         AiMessageLink[]
  importJobs             ImportJob[]
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  deletedAt              DateTime?                 @map("deleted_at")

  @@index([status])
  @@map("users")
}

model Merchant {
  id              String                  @id @default(cuid()) @db.VarChar(30)
  code            String                  @unique @db.VarChar(32)
  name            String                  @db.VarChar(120)
  status          MerchantStatus          @default(ACTIVE)
  defaultCurrency String                  @default("USD") @map("default_currency") @db.Char(3)
  merchantUsers   MerchantUser[]
  products        Product[]
  skus            Sku[]
  orders          Order[]
  aiSessions      AiSession[]
  optimizations   ProductOptimization[]
  productVersions ProductVersion[]
  auditLogs       AuditLog[]
  batchTasks      BatchOptimizationTask[]
  ruleDocuments   RuleDocument[]
  agentRuns       AgentRun[]
  aiSessionShares AiSessionShare[]
  importJobs      ImportJob[]
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  stores          Store[]
  productListings ProductListing[]

  @@index([status])
  @@map("merchants")
}

model MerchantUser {
  merchantId String   @map("merchant_id") @db.VarChar(30)
  userId     String   @map("user_id") @db.VarChar(30)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([merchantId, userId])
  @@index([userId])
  @@map("merchant_users")
}

model Store {
  id         String           @id @default(cuid()) @db.VarChar(30)
  merchantId String           @map("merchant_id") @db.VarChar(30)
  code       String           @db.VarChar(32)
  name       String           @db.VarChar(120)
  platform   String           @db.VarChar(40)
  market     String           @db.Char(2)
  currency   String           @db.Char(3)
  locale     String           @db.VarChar(16)
  timezone   String           @db.VarChar(64)
  status     StoreStatus      @default(ACTIVE)
  merchant   Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  listings   ProductListing[]
  orders     Order[]
  agentRuns  AgentRun[]
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@unique([merchantId, code])
  @@unique([id, merchantId])
  @@index([merchantId, status, createdAt])
  @@map("stores")
}

model Product {
  id            String                  @id @default(cuid()) @db.VarChar(30)
  merchantId    String                  @map("merchant_id") @db.VarChar(30)
  code          String                  @db.VarChar(64)
  title         String                  @db.VarChar(255)
  description   String                  @db.Text
  sellingPoints Json                    @default("[]") @map("selling_points")
  language      String                  @default("zh-CN") @db.VarChar(16)
  status        ProductStatus           @default(DRAFT)
  version       Int                     @default(1)
  merchant      Merchant                @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  skus          Sku[]
  optimizations ProductOptimization[]
  versions      ProductVersion[]
  batchItems    BatchOptimizationItem[]
  listings      ProductListing[]
  importItems   ImportItem[]
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  @@unique([merchantId, code])
  @@unique([id, merchantId])
  @@index([merchantId, status, updatedAt])
  @@map("products")
}

model ProductListing {
  id                String               @id @default(cuid()) @db.VarChar(30)
  merchantId        String               @map("merchant_id") @db.VarChar(30)
  storeId           String               @map("store_id") @db.VarChar(30)
  productId         String               @map("product_id") @db.VarChar(30)
  externalProductId String?              @map("external_product_id") @db.VarChar(100)
  title             String               @db.VarChar(255)
  description       String               @db.Text
  language          String               @db.VarChar(16)
  price             Decimal              @db.Decimal(12, 2)
  currency          String               @db.Char(3)
  status            ProductListingStatus @default(DRAFT)
  merchant          Merchant             @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  store             Store                @relation(fields: [storeId, merchantId], references: [id, merchantId], onDelete: Restrict)
  product           Product              @relation(fields: [productId, merchantId], references: [id, merchantId], onDelete: Restrict)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@unique([storeId, productId])
  @@index([merchantId, storeId, status, updatedAt])
  @@index([merchantId, productId])
  @@map("product_listings")
}

model ProductOptimization {
  id                 String                    @id @default(cuid()) @db.VarChar(30)
  merchantId         String                    @map("merchant_id") @db.VarChar(30)
  productId          String                    @map("product_id") @db.VarChar(30)
  requestedById      String                    @map("requested_by_id") @db.VarChar(30)
  status             ProductOptimizationStatus @default(GENERATING)
  targetLanguage     String                    @map("target_language") @db.VarChar(16)
  baseProductVersion Int                       @map("base_product_version")
  sourceData         Json                      @map("source_data")
  draftData          Json?                     @map("draft_data")
  providerName       String?                   @map("provider_name") @db.VarChar(64)
  modelName          String?                   @map("model_name") @db.VarChar(128)
  promptTokens       Int                       @default(0) @map("prompt_tokens")
  completionTokens   Int                       @default(0) @map("completion_tokens")
  totalTokens        Int                       @default(0) @map("total_tokens")
  batchItemId        String?                   @unique @map("batch_item_id") @db.VarChar(30)
  importItemId       String?                   @unique @map("import_item_id") @db.VarChar(30)
  error              String?                   @db.VarChar(1000)
  appliedAt          DateTime?                 @map("applied_at")
  merchant           Merchant                  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  product            Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  requestedBy        User                      @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  version            ProductVersion?
  batchItem          BatchOptimizationItem?    @relation(fields: [batchItemId], references: [id], onDelete: SetNull)
  importItem         ImportItem?               @relation(fields: [importItemId], references: [id], onDelete: SetNull)
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  @@index([merchantId, productId, createdAt])
  @@index([requestedById, createdAt])
  @@map("product_optimizations")
}

model BatchOptimizationTask {
  id             String                  @id @default(cuid()) @db.VarChar(30)
  merchantId     String                  @map("merchant_id") @db.VarChar(30)
  createdById    String                  @map("created_by_id") @db.VarChar(30)
  idempotencyKey String                  @map("idempotency_key") @db.VarChar(64)
  targetLanguage String                  @map("target_language") @db.VarChar(16)
  status         BatchTaskStatus         @default(PENDING)
  totalItems     Int                     @map("total_items")
  completedItems Int                     @default(0) @map("completed_items")
  failedItems    Int                     @default(0) @map("failed_items")
  cancelledItems Int                     @default(0) @map("cancelled_items")
  startedAt      DateTime?               @map("started_at")
  completedAt    DateTime?               @map("completed_at")
  cancelledAt    DateTime?               @map("cancelled_at")
  merchant       Merchant                @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  createdBy      User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items          BatchOptimizationItem[]
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  @@unique([merchantId, idempotencyKey])
  @@index([merchantId, createdAt])
  @@index([createdById, createdAt])
  @@map("batch_optimization_tasks")
}

model BatchOptimizationItem {
  id           String                @id @default(cuid()) @db.VarChar(30)
  taskId       String                @map("task_id") @db.VarChar(30)
  productId    String                @map("product_id") @db.VarChar(30)
  status       BatchTaskItemStatus   @default(PENDING)
  attempts     Int                   @default(0)
  error        String?               @db.VarChar(1000)
  startedAt    DateTime?             @map("started_at")
  completedAt  DateTime?             @map("completed_at")
  task         BatchOptimizationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  product      Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  optimization ProductOptimization?
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@unique([taskId, productId])
  @@index([taskId, status])
  @@index([productId, createdAt])
  @@map("batch_optimization_items")
}

model ImportJob {
  id             String          @id @default(cuid()) @db.VarChar(30)
  merchantId     String          @map("merchant_id") @db.VarChar(30)
  createdById    String          @map("created_by_id") @db.VarChar(30)
  idempotencyKey String          @map("idempotency_key") @db.VarChar(100)
  fileName       String          @map("file_name") @db.VarChar(255)
  fileHash       String          @map("file_hash") @db.Char(64)
  fileType       String          @map("file_type") @db.VarChar(16)
  worksheet      String?         @db.VarChar(120)
  headerRow      Int             @default(1) @map("header_row")
  mapping        Json
  mode           ImportMode
  targetLanguage String?         @map("target_language") @db.VarChar(16)
  status         ImportJobStatus @default(PENDING)
  totalItems     Int             @map("total_items")
  validItems     Int             @map("valid_items")
  invalidItems   Int             @map("invalid_items")
  completedItems Int             @default(0) @map("completed_items")
  failedItems    Int             @default(0) @map("failed_items")
  cancelledItems Int             @default(0) @map("cancelled_items")
  cancelledAt    DateTime?       @map("cancelled_at")
  startedAt      DateTime?       @map("started_at")
  completedAt    DateTime?       @map("completed_at")
  merchant       Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items          ImportItem[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@unique([merchantId, idempotencyKey])
  @@index([merchantId, createdAt])
  @@index([merchantId, status, createdAt])
  @@map("import_jobs")
}

model ImportItem {
  id             String               @id @default(cuid()) @db.VarChar(30)
  jobId          String               @map("job_id") @db.VarChar(30)
  rowNumber      Int                  @map("row_number")
  status         ImportItemStatus
  sourceData     Json                 @map("source_data")
  normalizedData Json?                @map("normalized_data")
  warnings       Json                 @default("[]")
  error          String?              @db.VarChar(1000)
  productId      String?              @map("product_id") @db.VarChar(30)
  attempts       Int                  @default(0)
  startedAt      DateTime?            @map("started_at")
  completedAt    DateTime?            @map("completed_at")
  job            ImportJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  product        Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  optimization   ProductOptimization?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@unique([jobId, rowNumber])
  @@index([jobId, status, rowNumber])
  @@index([productId])
  @@map("import_items")
}

model RuleDocument {
  id          String             @id @default(cuid()) @db.VarChar(30)
  merchantId  String?            @map("merchant_id") @db.VarChar(30)
  createdById String             @map("created_by_id") @db.VarChar(30)
  title       String             @db.VarChar(255)
  platform    String             @db.VarChar(64)
  scope       RuleDocumentScope
  sourceUrl   String?            @map("source_url") @db.VarChar(500)
  content     String             @db.MediumText
  contentHash String             @map("content_hash") @db.Char(64)
  status      RuleDocumentStatus @default(ACTIVE)
  merchant    Merchant?          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  createdBy   User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  chunks      RuleChunk[]
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([merchantId, status, createdAt])
  @@index([scope, status, createdAt])
  @@index([contentHash])
  @@index([createdById])
  @@map("rule_documents")
}

model RuleChunk {
  id          String       @id @default(cuid()) @db.VarChar(30)
  documentId  String       @map("document_id") @db.VarChar(30)
  sequence    Int
  heading     String?      @db.VarChar(255)
  content     String       @db.Text
  searchTerms Json         @map("search_terms")
  document    RuleDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now()) @map("created_at")

  @@unique([documentId, sequence])
  @@index([documentId])
  @@map("rule_chunks")
}

model ProductVersion {
  id             String               @id @default(cuid()) @db.VarChar(30)
  merchantId     String               @map("merchant_id") @db.VarChar(30)
  productId      String               @map("product_id") @db.VarChar(30)
  optimizationId String?              @unique @map("optimization_id") @db.VarChar(30)
  actorUserId    String               @map("actor_user_id") @db.VarChar(30)
  version        Int
  beforeData     Json                 @map("before_data")
  afterData      Json                 @map("after_data")
  merchant       Merchant             @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  product        Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  optimization   ProductOptimization? @relation(fields: [optimizationId], references: [id], onDelete: SetNull)
  actor          User                 @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime             @default(now()) @map("created_at")

  @@unique([productId, version])
  @@index([merchantId, productId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("product_versions")
}

model Sku {
  id         String    @id @default(cuid()) @db.VarChar(30)
  merchantId String    @map("merchant_id") @db.VarChar(30)
  productId  String    @map("product_id") @db.VarChar(30)
  code       String    @db.VarChar(64)
  name       String    @db.VarChar(120)
  price      Decimal   @db.Decimal(12, 2)
  currency   String    @db.Char(3)
  stock      Int       @default(0)
  status     SkuStatus @default(ACTIVE)
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  product    Product   @relation(fields: [productId, merchantId], references: [id, merchantId], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([merchantId, code])
  @@index([productId, status])
  @@index([merchantId, status])
  @@map("skus")
}

model Order {
  id              String      @id @default(cuid()) @db.VarChar(30)
  merchantId      String      @map("merchant_id") @db.VarChar(30)
  storeId         String?     @map("store_id") @db.VarChar(30)
  orderNo         String      @map("order_no") @db.VarChar(64)
  status          OrderStatus @default(PENDING)
  customerName    String      @map("customer_name") @db.VarChar(100)
  customerEmail   String?     @map("customer_email") @db.VarChar(191)
  shippingAddress Json?       @map("shipping_address")
  totalAmount     Decimal     @map("total_amount") @db.Decimal(12, 2)
  currency        String      @default("USD") @db.Char(3)
  notes           String?     @db.VarChar(500)
  merchant        Merchant    @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  store           Store?      @relation(fields: [storeId, merchantId], references: [id, merchantId], onDelete: Restrict)
  items           OrderItem[]
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@unique([merchantId, orderNo])
  @@unique([id, merchantId])
  @@index([merchantId, status, createdAt])
  @@index([merchantId, storeId, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid()) @db.VarChar(30)
  orderId     String  @map("order_id") @db.VarChar(30)
  productId   String? @map("product_id") @db.VarChar(30)
  skuId       String? @map("sku_id") @db.VarChar(30)
  productName String  @map("product_name") @db.VarChar(255)
  skuName     String  @map("sku_name") @db.VarChar(120)
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)
  currency    String  @default("USD") @db.Char(3)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

enum AiSessionStatus {
  IDLE
  STREAMING
  DONE
  ERROR
}

model AiSession {
  id           String           @id @default(cuid()) @db.VarChar(30)
  merchantId   String           @map("merchant_id") @db.VarChar(30)
  userId       String           @map("user_id") @db.VarChar(30)
  title        String           @db.VarChar(255)
  status       AiSessionStatus  @default(IDLE)
  error        String?          @db.VarChar(500)
  pinned       Boolean          @default(false)
  groupId      String?          @map("group_id") @db.VarChar(30)
  archivedAt   DateTime?        @map("archived_at")
  merchant     Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages     AiMessage[]
  shares       AiSessionShare[]
  messageLinks AiMessageLink[]
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([merchantId, userId, archivedAt, updatedAt])
  @@index([userId])
  @@map("ai_sessions")
}

model AiMessage {
  id           String          @id @default(cuid()) @db.VarChar(30)
  sessionId    String          @map("session_id") @db.VarChar(30)
  role         String          @db.VarChar(16)
  content      String          @db.MediumText
  parentId     String?         @map("parent_id") @db.VarChar(30)
  childrenIds  Json            @default("[]") @map("children_ids")
  revisionJson Json?           @map("revision_json")
  revisionIdx  Int             @default(0) @map("revision_idx")
  favorited    Boolean         @default(false)
  session      AiSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  links        AiMessageLink[]
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@index([sessionId, parentId])
  @@map("ai_messages")
}

model AiMessageLink {
  id          String    @id @default(cuid()) @db.VarChar(30)
  sessionId   String    @map("session_id") @db.VarChar(30)
  messageId   String    @map("message_id") @db.VarChar(30)
  createdById String    @map("created_by_id") @db.VarChar(30)
  entityType  String    @map("entity_type") @db.VarChar(24)
  entityId    String    @map("entity_id") @db.VarChar(30)
  entityCode  String    @map("entity_code") @db.VarChar(64)
  entityLabel String    @map("entity_label") @db.VarChar(255)
  session     AiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message     AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([messageId, entityType, entityId])
  @@index([sessionId, createdAt])
  @@map("ai_message_links")
}

model AiSessionShare {
  id          String                    @id @default(cuid()) @db.VarChar(30)
  merchantId  String                    @map("merchant_id") @db.VarChar(30)
  sessionId   String                    @map("session_id") @db.VarChar(30)
  createdById String                    @map("created_by_id") @db.VarChar(30)
  title       String                    @db.VarChar(255)
  snapshot    Json
  expiresAt   DateTime                  @map("expires_at")
  revokedAt   DateTime?                 @map("revoked_at")
  merchant    Merchant                  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  session     AiSession                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy   User                      @relation("SessionShareCreator", fields: [createdById], references: [id], onDelete: Restrict)
  recipients  AiSessionShareRecipient[]
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")

  @@index([merchantId, createdAt])
  @@index([sessionId, createdAt])
  @@index([expiresAt, revokedAt])
  @@map("ai_session_shares")
}

model AiSessionShareRecipient {
  shareId   String         @map("share_id") @db.VarChar(30)
  userId    String         @map("user_id") @db.VarChar(30)
  share     AiSessionShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now()) @map("created_at")

  @@id([shareId, userId])
  @@index([userId, createdAt])
  @@map("ai_session_share_recipients")
}

model AgentRun {
  id                     String          @id @default(cuid()) @db.VarChar(30)
  merchantId             String          @map("merchant_id") @db.VarChar(30)
  storeId                String?         @map("store_id") @db.VarChar(30)
  userId                 String          @map("user_id") @db.VarChar(30)
  message                String          @db.VarChar(1000)
  answer                 String?         @db.MediumText
  status                 AgentRunStatus  @default(PLANNING)
  sourcePage             String?         @map("source_page") @db.VarChar(120)
  providerName           String?         @map("provider_name") @db.VarChar(64)
  modelName              String?         @map("model_name") @db.VarChar(128)
  promptTokens           Int             @default(0) @map("prompt_tokens")
  completionTokens       Int             @default(0) @map("completion_tokens")
  totalTokens            Int             @default(0) @map("total_tokens")
  createdOptimizationIds Json            @default("[]") @map("created_optimization_ids")
  error                  String?         @db.VarChar(1000)
  completedAt            DateTime?       @map("completed_at")
  merchant               Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  store                  Store?          @relation(fields: [storeId, merchantId], references: [id, merchantId], onDelete: Restrict)
  user                   User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  toolCalls              AgentToolCall[]
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  @@index([merchantId, createdAt])
  @@index([merchantId, status, createdAt])
  @@index([merchantId, storeId, createdAt])
  @@index([userId, createdAt])
  @@map("agent_runs")
}

model AgentToolCall {
  id             String   @id @default(cuid()) @db.VarChar(30)
  runId          String   @map("run_id") @db.VarChar(30)
  externalCallId String   @map("external_call_id") @db.VarChar(120)
  name           String   @db.VarChar(80)
  status         String   @db.VarChar(16)
  sequence       Int
  input          Json
  output         Json?
  error          String?  @db.VarChar(1000)
  run            AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([runId, externalCallId])
  @@index([runId, sequence])
  @@map("agent_tool_calls")
}

model AuditLog {
  id          String   @id @default(cuid()) @db.VarChar(30)
  merchantId  String   @map("merchant_id") @db.VarChar(30)
  actorUserId String   @map("actor_user_id") @db.VarChar(30)
  entityType  String   @map("entity_type") @db.VarChar(32)
  entityId    String   @map("entity_id") @db.VarChar(30)
  action      String   @db.VarChar(32)
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([merchantId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model Role {
  id        String     @id @default(cuid()) @db.VarChar(30)
  code      String     @unique @db.VarChar(32)
  name      String     @db.VarChar(64)
  userRoles UserRole[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.VarChar(30)
  roleId     String   @map("role_id") @db.VarChar(30)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(cuid()) @db.VarChar(30)
  userId    String    @map("user_id") @db.VarChar(30)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  familyId  String    @map("family_id") @db.VarChar(36)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model LoginLog {
  id        String      @id @default(cuid()) @db.VarChar(30)
  userId    String?     @map("user_id") @db.VarChar(30)
  email     String      @db.VarChar(191)
  result    LoginResult
  ipAddress String?     @map("ip_address") @db.VarChar(64)
  userAgent String?     @map("user_agent") @db.VarChar(512)
  createdAt DateTime    @default(now()) @map("created_at")
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@map("login_logs")
}
