generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum LoginResult {
  SUCCESS
  FAILURE
}

enum MerchantStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SkuStatus {
  ACTIVE
  DISABLED
}

model User {
  id            String         @id @default(cuid()) @db.VarChar(30)
  email         String         @unique @db.VarChar(191)
  name          String         @db.VarChar(100)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  status        UserStatus     @default(ACTIVE)
  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  loginLogs     LoginLog[]
  merchantUsers MerchantUser[]
  auditLogs     AuditLog[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  @@index([status])
  @@map("users")
}

model Merchant {
  id              String         @id @default(cuid()) @db.VarChar(30)
  code            String         @unique @db.VarChar(32)
  name            String         @db.VarChar(120)
  status          MerchantStatus @default(ACTIVE)
  defaultCurrency String         @default("USD") @map("default_currency") @db.Char(3)
  merchantUsers   MerchantUser[]
  products        Product[]
  skus            Sku[]
  auditLogs       AuditLog[]
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@map("merchants")
}

model MerchantUser {
  merchantId String   @map("merchant_id") @db.VarChar(30)
  userId     String   @map("user_id") @db.VarChar(30)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([merchantId, userId])
  @@index([userId])
  @@map("merchant_users")
}

model Product {
  id          String        @id @default(cuid()) @db.VarChar(30)
  merchantId  String        @map("merchant_id") @db.VarChar(30)
  code        String        @db.VarChar(64)
  title       String        @db.VarChar(255)
  description String        @db.Text
  language    String        @default("zh-CN") @db.VarChar(16)
  status      ProductStatus @default(DRAFT)
  merchant    Merchant      @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  skus        Sku[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([merchantId, code])
  @@unique([id, merchantId])
  @@index([merchantId, status, updatedAt])
  @@map("products")
}

model Sku {
  id         String    @id @default(cuid()) @db.VarChar(30)
  merchantId String    @map("merchant_id") @db.VarChar(30)
  productId  String    @map("product_id") @db.VarChar(30)
  code       String    @db.VarChar(64)
  name       String    @db.VarChar(120)
  price      Decimal   @db.Decimal(12, 2)
  currency   String    @db.Char(3)
  stock      Int       @default(0)
  status     SkuStatus @default(ACTIVE)
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  product    Product   @relation(fields: [productId, merchantId], references: [id, merchantId], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([merchantId, code])
  @@index([productId, status])
  @@index([merchantId, status])
  @@map("skus")
}

model AuditLog {
  id          String   @id @default(cuid()) @db.VarChar(30)
  merchantId  String   @map("merchant_id") @db.VarChar(30)
  actorUserId String   @map("actor_user_id") @db.VarChar(30)
  entityType  String   @map("entity_type") @db.VarChar(32)
  entityId    String   @map("entity_id") @db.VarChar(30)
  action      String   @db.VarChar(32)
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([merchantId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model Role {
  id        String     @id @default(cuid()) @db.VarChar(30)
  code      String     @unique @db.VarChar(32)
  name      String     @db.VarChar(64)
  userRoles UserRole[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.VarChar(30)
  roleId     String   @map("role_id") @db.VarChar(30)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(cuid()) @db.VarChar(30)
  userId    String    @map("user_id") @db.VarChar(30)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  familyId  String    @map("family_id") @db.VarChar(36)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model LoginLog {
  id        String      @id @default(cuid()) @db.VarChar(30)
  userId    String?     @map("user_id") @db.VarChar(30)
  email     String      @db.VarChar(191)
  result    LoginResult
  ipAddress String?     @map("ip_address") @db.VarChar(64)
  userAgent String?     @map("user_agent") @db.VarChar(512)
  createdAt DateTime    @default(now()) @map("created_at")
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@map("login_logs")
}
